NODE_ENV=production
PORT=5000
TRUST_PROXY=true
FRONTEND_URL=https://your-domain.example
API_ORIGIN=https://api.your-domain.example

# Authentication
JWT_SECRET=replace-with-at-least-32-random-bytes
REQUIRE_EMAIL_VERIFICATION=true
PRIMARY_ADMIN_EMAIL=owner@your-domain.example

# Production persistence (MongoDB must support transactions/replica sets)
DATABASE=mongo
MONGO_URI=mongodb+srv://user:password@cluster/database
MONGO_DB_NAME=versusversevault
MONGO_CACHE_TTL_MS=0

# Abuse controls (safe production defaults)
API_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=15
REGISTER_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=5
SHARE_RENDER_RATE_LIMIT_MAX=30

# Email delivery
EMAIL_HOST=smtp.provider.example
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=smtp-user
EMAIL_PASS=smtp-password
EMAIL_FROM=VersusVerseVault <no-reply@your-domain.example>

# Legal pages: replace these only after review by the operator/legal adviser
LEGAL_ENTITY_NAME=Your legal name or company
PRIVACY_CONTACT_EMAIL=privacy@your-domain.example
SUPPORT_CONTACT_EMAIL=support@your-domain.example
LEGAL_JURISDICTION=Poland
MINIMUM_AGE=16
LEGAL_POLICY_VERSION=2026-07-28

# Optional integrations
GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
# Disabled by default. Set to mymemory only after accepting the privacy implications.
TRANSLATION_PROVIDER=disabled
TRANSLATION_RATE_LIMIT_MAX=30

# Optional donation providers. The UI stays disabled when both are empty.
DONATION_BUYMEACOFFEE_URL=
DONATION_PAYPAL_URL=
DONATION_MONTHLY_GOAL=1000
DONATION_CURRENCY=USD
